# Supabase (Settings → API). Use um projeto hospedado no Brasil (região São Paulo).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor: convites, bloqueio de login, exclusão de conta e despacho de notificações.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do app (links de convite e de eventos públicos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notificações push (gere com: npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.org.br

# Chamado pelo agendador (cron) em POST /api/notificacoes/despachar
CRON_SECRET=

# E-mail das notificações (opcional — https://resend.com). Sem chave, só push.
RESEND_API_KEY=
EMAIL_REMETENTE="Família Maçônica <avisos@exemplo.org.br>"
